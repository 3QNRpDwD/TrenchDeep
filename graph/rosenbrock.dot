digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "HandleId(19)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(21)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_35d923fd1be28761" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(27)" [label="scalar_10", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(17)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(5)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Sub_61edbb487911a4b" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(15)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_8fc7c691c23756c6" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(7)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "HandleId(25)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_9419e965a52f00cf" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(13)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(23)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_83b9b15c437d269a" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Add_bb37ed12c663785b" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_9598db3ff3e14830" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(29)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    { rank=same; "HandleId(5)"; "HandleId(7)"; }
    { rank=same; "HandleId(15)"; "HandleId(23)"; }
    { rank=source; "HandleId(5)"; "HandleId(7)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "HandleId(5)" -> "Square_9419e965a52f00cf" [style=solid, color="#2E86AB", penwidth=2];
    "Square_9419e965a52f00cf" -> "HandleId(13)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(7)" -> "Sub_61edbb487911a4b" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(13)" -> "Sub_61edbb487911a4b" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_61edbb487911a4b" -> "HandleId(17)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(17)" -> "Square_8fc7c691c23756c6" [style=solid, color="#2E86AB", penwidth=2];
    "Square_8fc7c691c23756c6" -> "HandleId(19)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(15)" -> "Mul_83b9b15c437d269a" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(19)" -> "Mul_83b9b15c437d269a" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_83b9b15c437d269a" -> "HandleId(21)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(23)" -> "Sub_9598db3ff3e14830" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(5)" -> "Sub_9598db3ff3e14830" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_9598db3ff3e14830" -> "HandleId(25)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(25)" -> "Square_35d923fd1be28761" [style=solid, color="#2E86AB", penwidth=2];
    "Square_35d923fd1be28761" -> "HandleId(27)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(21)" -> "Add_bb37ed12c663785b" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(27)" -> "Add_bb37ed12c663785b" [style=solid, color="#2E86AB", penwidth=2];
    "Add_bb37ed12c663785b" -> "HandleId(29)" [style=solid, color="#2E86AB", penwidth=2];
}
