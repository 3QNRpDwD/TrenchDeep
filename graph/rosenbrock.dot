digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "0x2432130e690" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(66)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(47)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x24321306290" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x24321306380" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x24321306260" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(53)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(69)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x2432130e4b0" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(67)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(54)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(62)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x2432130e360" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x2432130e3c0" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(71)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(80)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(70)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(46)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    { rank=source; "NodeId(47)"; "NodeId(53)"; "NodeId(69)"; "NodeId(46)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(46)" -> "0x24321306260" [style=solid, color="#2E86AB", penwidth=2];
    "0x24321306260" -> "NodeId(54)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(47)" -> "0x24321306290" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(54)" -> "0x24321306290" [style=solid, color="#2E86AB", penwidth=2];
    "0x24321306290" -> "NodeId(62)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(62)" -> "0x24321306380" [style=solid, color="#2E86AB", penwidth=2];
    "0x24321306380" -> "NodeId(66)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(53)" -> "0x2432130e690" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(66)" -> "0x2432130e690" [style=solid, color="#2E86AB", penwidth=2];
    "0x2432130e690" -> "NodeId(67)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(69)" -> "0x2432130e360" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(46)" -> "0x2432130e360" [style=solid, color="#2E86AB", penwidth=2];
    "0x2432130e360" -> "NodeId(70)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(70)" -> "0x2432130e3c0" [style=solid, color="#2E86AB", penwidth=2];
    "0x2432130e3c0" -> "NodeId(71)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(67)" -> "0x2432130e4b0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(71)" -> "0x2432130e4b0" [style=solid, color="#2E86AB", penwidth=2];
    "0x2432130e4b0" -> "NodeId(80)" [style=solid, color="#2E86AB", penwidth=2];
}
