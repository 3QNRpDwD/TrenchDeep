digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Sub_8aa624dd41487f6f" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_e5c497f118456576" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(401)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_65145f84a3de2683" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(399)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_17bce524c1c4ed83" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(382)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "HandleId(405)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(390)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(395)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(380)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "HandleId(412)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "HandleId(407)" [label="scalar_10", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_74665c689aab1e2d" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(388)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(393)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_33b063ac0a5c7b3c" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_38bf52d435e1d90a" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    { rank=same; "HandleId(382)"; "HandleId(380)"; }
    { rank=same; "HandleId(401)"; "HandleId(390)"; }
    { rank=source; "HandleId(382)"; "HandleId(380)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "HandleId(380)" -> "Square_65145f84a3de2683" [style=solid, color="#2E86AB", penwidth=2];
    "Square_65145f84a3de2683" -> "HandleId(388)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(382)" -> "Sub_17bce524c1c4ed83" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(388)" -> "Sub_17bce524c1c4ed83" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_17bce524c1c4ed83" -> "HandleId(393)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(393)" -> "Square_38bf52d435e1d90a" [style=solid, color="#2E86AB", penwidth=2];
    "Square_38bf52d435e1d90a" -> "HandleId(395)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(390)" -> "Mul_33b063ac0a5c7b3c" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(395)" -> "Mul_33b063ac0a5c7b3c" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_33b063ac0a5c7b3c" -> "HandleId(399)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(401)" -> "Sub_8aa624dd41487f6f" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(380)" -> "Sub_8aa624dd41487f6f" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_8aa624dd41487f6f" -> "HandleId(405)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(405)" -> "Square_e5c497f118456576" [style=solid, color="#2E86AB", penwidth=2];
    "Square_e5c497f118456576" -> "HandleId(407)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(399)" -> "Add_74665c689aab1e2d" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(407)" -> "Add_74665c689aab1e2d" [style=solid, color="#2E86AB", penwidth=2];
    "Add_74665c689aab1e2d" -> "HandleId(412)" [style=solid, color="#2E86AB", penwidth=2];
}
