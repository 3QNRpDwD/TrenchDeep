digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(4)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Square_51693f28790c32e5" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Add_99e9855f94d071c3" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_4a00a6f546ee0673" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(71)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(52)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(47)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(3)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Sub_7fcc1a6793db675b" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_9959ced36e0499ed" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(16)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_dfb982bc79ab616f" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(60)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(29)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_8939e5f8aaa97333" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(39)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(11)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(53)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(11)"; "NodeId(52)"; }
    { rank=source; "NodeId(4)"; "NodeId(3)"; }
    { rank=sink; "NodeId(71)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(3)" -> "Square_9959ced36e0499ed" [style=solid, color="#2E86AB", penwidth=2];
    "Square_9959ced36e0499ed" -> "NodeId(16)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(4)" -> "Sub_4a00a6f546ee0673" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(16)" -> "Sub_4a00a6f546ee0673" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_4a00a6f546ee0673" -> "NodeId(29)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(29)" -> "Square_51693f28790c32e5" [style=solid, color="#2E86AB", penwidth=2];
    "Square_51693f28790c32e5" -> "NodeId(39)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(11)" -> "Mul_8939e5f8aaa97333" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(39)" -> "Mul_8939e5f8aaa97333" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_8939e5f8aaa97333" -> "NodeId(47)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(52)" -> "Sub_7fcc1a6793db675b" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(3)" -> "Sub_7fcc1a6793db675b" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_7fcc1a6793db675b" -> "NodeId(53)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(53)" -> "Square_dfb982bc79ab616f" [style=solid, color="#2E86AB", penwidth=2];
    "Square_dfb982bc79ab616f" -> "NodeId(60)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(47)" -> "Add_99e9855f94d071c3" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(60)" -> "Add_99e9855f94d071c3" [style=solid, color="#2E86AB", penwidth=2];
    "Add_99e9855f94d071c3" -> "NodeId(71)" [style=solid, color="#2E86AB", penwidth=2];
}
