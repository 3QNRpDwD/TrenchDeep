digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(33)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_f05c66571c896590" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(157)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(87)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(20)" [label="x1", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(100)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_8fc7c691c23756c6" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_abd3e467f84619f7" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(79)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(124)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(138)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(91)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_cae5f4c1aa2a7e71" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(107)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_8b0d24405e26abf0" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_d9eb7598fe4daea4" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(17)" [label="x0", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_feab63abbc2663fd" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    { rank=same; "NodeId(20)"; "NodeId(17)"; "NodeId(107)"; "NodeId(79)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(17)" -> "Square_8fc7c691c23756c6" [style=solid, color="#2E86AB", penwidth=2];
    "Square_8fc7c691c23756c6" -> "NodeId(33)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(20)" -> "Sub_8b0d24405e26abf0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(33)" -> "Sub_8b0d24405e26abf0" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_8b0d24405e26abf0" -> "NodeId(87)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(87)" -> "Square_cae5f4c1aa2a7e71" [style=solid, color="#2E86AB", penwidth=2];
    "Square_cae5f4c1aa2a7e71" -> "NodeId(91)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(79)" -> "Mul_feab63abbc2663fd" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(91)" -> "Mul_feab63abbc2663fd" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_feab63abbc2663fd" -> "NodeId(100)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(107)" -> "Sub_d9eb7598fe4daea4" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(17)" -> "Sub_d9eb7598fe4daea4" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_d9eb7598fe4daea4" -> "NodeId(124)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(124)" -> "Square_abd3e467f84619f7" [style=solid, color="#2E86AB", penwidth=2];
    "Square_abd3e467f84619f7" -> "NodeId(138)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(100)" -> "Add_f05c66571c896590" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(138)" -> "Add_f05c66571c896590" [style=solid, color="#2E86AB", penwidth=2];
    "Add_f05c66571c896590" -> "NodeId(157)" [style=solid, color="#2E86AB", penwidth=2];
}
