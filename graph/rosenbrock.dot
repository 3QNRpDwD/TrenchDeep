digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Square_19c19e17445ed631" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(73)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(88)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "Square_eca7294d08fe8b9e" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(2)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(76)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_8d9de9cce44a7bcb" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(68)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(27)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(0)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Square_d0c5f0194a82961d" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(82)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_a28d262016ce1656" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(62)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_8364ec6587372df7" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(23)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_54aa5d3caab506f3" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(57)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(73)"; "NodeId(23)"; }
    { rank=source; "NodeId(2)"; "NodeId(0)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(0)" -> "Square_eca7294d08fe8b9e" [style=solid, color="#2E86AB", penwidth=2];
    "Square_eca7294d08fe8b9e" -> "NodeId(27)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2)" -> "Sub_8d9de9cce44a7bcb" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(27)" -> "Sub_8d9de9cce44a7bcb" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_8d9de9cce44a7bcb" -> "NodeId(57)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(57)" -> "Square_19c19e17445ed631" [style=solid, color="#2E86AB", penwidth=2];
    "Square_19c19e17445ed631" -> "NodeId(62)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(23)" -> "Mul_a28d262016ce1656" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(62)" -> "Mul_a28d262016ce1656" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_a28d262016ce1656" -> "NodeId(68)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(73)" -> "Sub_8364ec6587372df7" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(0)" -> "Sub_8364ec6587372df7" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_8364ec6587372df7" -> "NodeId(76)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(76)" -> "Square_d0c5f0194a82961d" [style=solid, color="#2E86AB", penwidth=2];
    "Square_d0c5f0194a82961d" -> "NodeId(82)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(68)" -> "Add_54aa5d3caab506f3" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(82)" -> "Add_54aa5d3caab506f3" [style=solid, color="#2E86AB", penwidth=2];
    "Add_54aa5d3caab506f3" -> "NodeId(88)" [style=solid, color="#2E86AB", penwidth=2];
}
