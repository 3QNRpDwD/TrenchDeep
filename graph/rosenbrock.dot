digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Square_ddde0751317b047b" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(56)" [label="x0", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(126)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_305c3f018cf86fe0" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_60310ff129207d9f" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(95)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_b7e12998d251cd4b" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(128)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(105)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_31810450c199162a" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_db52ada4ed8a32e4" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(122)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(111)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(119)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_2eade440d3268ab7" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(90)" [label="x1", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(102)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(99)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(99)"; "NodeId(119)"; "NodeId(90)"; "NodeId(56)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(56)" -> "Square_305c3f018cf86fe0" [style=solid, color="#2E86AB", penwidth=2];
    "Square_305c3f018cf86fe0" -> "NodeId(95)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(90)" -> "Sub_2eade440d3268ab7" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(95)" -> "Sub_2eade440d3268ab7" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_2eade440d3268ab7" -> "NodeId(102)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(102)" -> "Square_ddde0751317b047b" [style=solid, color="#2E86AB", penwidth=2];
    "Square_ddde0751317b047b" -> "NodeId(105)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(99)" -> "Mul_31810450c199162a" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(105)" -> "Mul_31810450c199162a" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_31810450c199162a" -> "NodeId(111)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(119)" -> "Sub_db52ada4ed8a32e4" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(56)" -> "Sub_db52ada4ed8a32e4" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_db52ada4ed8a32e4" -> "NodeId(122)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(122)" -> "Square_60310ff129207d9f" [style=solid, color="#2E86AB", penwidth=2];
    "Square_60310ff129207d9f" -> "NodeId(126)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(111)" -> "Add_b7e12998d251cd4b" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(126)" -> "Add_b7e12998d251cd4b" [style=solid, color="#2E86AB", penwidth=2];
    "Add_b7e12998d251cd4b" -> "NodeId(128)" [style=solid, color="#2E86AB", penwidth=2];
}
