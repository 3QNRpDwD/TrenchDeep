digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "NodeId(36)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1bdf9478d80, metadata: DynMetadata(0x7ff6e62ba0a0) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1bdf9478e40, metadata: DynMetadata(0x7ff6e62b9ff8) }" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(40)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1bdf9446ec0, metadata: DynMetadata(0x7ff6e62ba0a0) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(0)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(1)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(5)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(2)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "Pointer { addr: 0x1bdf9473540, metadata: DynMetadata(0x7ff6e62b9fc0) }" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(27)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(43)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1bdf9473420, metadata: DynMetadata(0x7ff6e62ba0d8) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1bdf9446b90, metadata: DynMetadata(0x7ff6e62ba0d8) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(35)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(49)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1bdf9478de0, metadata: DynMetadata(0x7ff6e62ba0d8) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(38)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    { rank=source; "NodeId(0)"; "NodeId(1)"; "NodeId(2)"; "NodeId(38)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(0)" -> "Pointer { addr: 0x1bdf9446b90, metadata: DynMetadata(0x7ff6e62ba0d8) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1bdf9446b90, metadata: DynMetadata(0x7ff6e62ba0d8) }" -> "NodeId(5)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(1)" -> "Pointer { addr: 0x1bdf9446ec0, metadata: DynMetadata(0x7ff6e62ba0a0) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(5)" -> "Pointer { addr: 0x1bdf9446ec0, metadata: DynMetadata(0x7ff6e62ba0a0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1bdf9446ec0, metadata: DynMetadata(0x7ff6e62ba0a0) }" -> "NodeId(27)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(27)" -> "Pointer { addr: 0x1bdf9473420, metadata: DynMetadata(0x7ff6e62ba0d8) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1bdf9473420, metadata: DynMetadata(0x7ff6e62ba0d8) }" -> "NodeId(35)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2)" -> "Pointer { addr: 0x1bdf9473540, metadata: DynMetadata(0x7ff6e62b9fc0) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(35)" -> "Pointer { addr: 0x1bdf9473540, metadata: DynMetadata(0x7ff6e62b9fc0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1bdf9473540, metadata: DynMetadata(0x7ff6e62b9fc0) }" -> "NodeId(36)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(38)" -> "Pointer { addr: 0x1bdf9478d80, metadata: DynMetadata(0x7ff6e62ba0a0) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(0)" -> "Pointer { addr: 0x1bdf9478d80, metadata: DynMetadata(0x7ff6e62ba0a0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1bdf9478d80, metadata: DynMetadata(0x7ff6e62ba0a0) }" -> "NodeId(40)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(40)" -> "Pointer { addr: 0x1bdf9478de0, metadata: DynMetadata(0x7ff6e62ba0d8) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1bdf9478de0, metadata: DynMetadata(0x7ff6e62ba0d8) }" -> "NodeId(43)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(36)" -> "Pointer { addr: 0x1bdf9478e40, metadata: DynMetadata(0x7ff6e62b9ff8) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(43)" -> "Pointer { addr: 0x1bdf9478e40, metadata: DynMetadata(0x7ff6e62b9ff8) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1bdf9478e40, metadata: DynMetadata(0x7ff6e62b9ff8) }" -> "NodeId(49)" [style=solid, color="#2E86AB", penwidth=2];
}
