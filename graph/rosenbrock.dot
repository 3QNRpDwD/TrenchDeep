digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.0;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(41)" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(36)" [label="x0", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(63)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(65)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(40)" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(45)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(61)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(39)" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(48)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(46)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(51)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(56)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(37)" [label="x1", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(64)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(38)" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(36)" -> "NodeId(40)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(40)" -> "NodeId(46)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(37)" -> "NodeId(38)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(46)" -> "NodeId(38)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(38)" -> "NodeId(48)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(48)" -> "NodeId(40)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(40)" -> "NodeId(51)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(45)" -> "NodeId(41)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(51)" -> "NodeId(41)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(41)" -> "NodeId(56)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(61)" -> "NodeId(38)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(36)" -> "NodeId(38)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(38)" -> "NodeId(63)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(63)" -> "NodeId(40)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(40)" -> "NodeId(64)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(56)" -> "NodeId(39)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(64)" -> "NodeId(39)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(39)" -> "NodeId(65)" [style=solid, color="#2E86AB", penwidth=2];
}
