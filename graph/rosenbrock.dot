digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(63)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(37)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Mul_719034bbed0574d8" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(57)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_8de6206861fe7018" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_7fb496fe6d3c71b3" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_eb15086278efc9a0" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(47)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(54)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(59)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(45)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_94641e4618046e22" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(44)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_d5097361f3160d12" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(60)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(35)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Add_e9730e5eb80a84b9" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(66)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    { rank=same; "NodeId(59)"; "NodeId(44)"; }
    { rank=source; "NodeId(37)"; "NodeId(35)"; }
    { rank=sink; "NodeId(66)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(35)" -> "Square_eb15086278efc9a0" [style=solid, color="#2E86AB", penwidth=2];
    "Square_eb15086278efc9a0" -> "NodeId(45)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(37)" -> "Sub_7fb496fe6d3c71b3" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(45)" -> "Sub_7fb496fe6d3c71b3" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_7fb496fe6d3c71b3" -> "NodeId(47)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(47)" -> "Square_94641e4618046e22" [style=solid, color="#2E86AB", penwidth=2];
    "Square_94641e4618046e22" -> "NodeId(54)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(44)" -> "Mul_719034bbed0574d8" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(54)" -> "Mul_719034bbed0574d8" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_719034bbed0574d8" -> "NodeId(57)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(59)" -> "Sub_d5097361f3160d12" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(35)" -> "Sub_d5097361f3160d12" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_d5097361f3160d12" -> "NodeId(60)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(60)" -> "Square_8de6206861fe7018" [style=solid, color="#2E86AB", penwidth=2];
    "Square_8de6206861fe7018" -> "NodeId(63)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(57)" -> "Add_e9730e5eb80a84b9" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(63)" -> "Add_e9730e5eb80a84b9" [style=solid, color="#2E86AB", penwidth=2];
    "Add_e9730e5eb80a84b9" -> "NodeId(66)" [style=solid, color="#2E86AB", penwidth=2];
}
