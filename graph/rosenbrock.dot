digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "0x1edc6e87ea0" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(43)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1edc6ec4e30" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(40)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1edc6ec4da0" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(36)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1edc6e877e0" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(34)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(28)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(31)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(41)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1edc6ec4e90" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(20)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x1edc6eca460" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(30)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(39)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x1edc6e87e70" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(19)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    { rank=source; "NodeId(28)"; "NodeId(20)"; "NodeId(39)"; "NodeId(19)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(19)" -> "0x1edc6e87e70" [style=solid, color="#2E86AB", penwidth=2];
    "0x1edc6e87e70" -> "NodeId(30)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(20)" -> "0x1edc6e87ea0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(30)" -> "0x1edc6e87ea0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1edc6e87ea0" -> "NodeId(31)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(31)" -> "0x1edc6e877e0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1edc6e877e0" -> "NodeId(34)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(28)" -> "0x1edc6ec4e90" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(34)" -> "0x1edc6ec4e90" [style=solid, color="#2E86AB", penwidth=2];
    "0x1edc6ec4e90" -> "NodeId(36)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(39)" -> "0x1edc6ec4e30" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(19)" -> "0x1edc6ec4e30" [style=solid, color="#2E86AB", penwidth=2];
    "0x1edc6ec4e30" -> "NodeId(40)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(40)" -> "0x1edc6ec4da0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1edc6ec4da0" -> "NodeId(41)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(36)" -> "0x1edc6eca460" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(41)" -> "0x1edc6eca460" [style=solid, color="#2E86AB", penwidth=2];
    "0x1edc6eca460" -> "NodeId(43)" [style=solid, color="#2E86AB", penwidth=2];
}
