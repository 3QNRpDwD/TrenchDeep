digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "0x16a5d1d0aa0" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x16a5d1d0e60" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x16a5d1c4570" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x16a5d1d0d20" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x16a5d1b2480, metadata: DynMetadata(0x7ff6cbcbaf00) }" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x16a5d1c4250" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x16a5d1b2660, metadata: DynMetadata(0x7ff6cbcbaf88) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x16a5d1b2510, metadata: DynMetadata(0x7ff6cbcbaff8) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x16a5d1c49d0" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x16a5d1cfd80" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x16a5d1c8210" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x16a5d1b24b0, metadata: DynMetadata(0x7ff6cbcbaf50) }" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x16a5d1c4750" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x16a5d1a25e0, metadata: DynMetadata(0x7ff6cbcbaff8) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x16a5d1c4ed0" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "Pointer { addr: 0x16a5d1b2540, metadata: DynMetadata(0x7ff6cbcbaf88) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x16a5d1cf920" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x16a5d1a24c0, metadata: DynMetadata(0x7ff6cbcbaf88) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    { rank=source; "0x16a5d1c4570"; "0x16a5d1c49d0"; "0x16a5d1cfd80"; "0x16a5d1c4ed0"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "0x16a5d1c4ed0" -> "Pointer { addr: 0x16a5d1a24c0, metadata: DynMetadata(0x7ff6cbcbaf88) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x16a5d1a24c0, metadata: DynMetadata(0x7ff6cbcbaf88) }" -> "0x16a5d1c4750" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1c4570" -> "Pointer { addr: 0x16a5d1a25e0, metadata: DynMetadata(0x7ff6cbcbaff8) }" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1c4750" -> "Pointer { addr: 0x16a5d1a25e0, metadata: DynMetadata(0x7ff6cbcbaff8) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x16a5d1a25e0, metadata: DynMetadata(0x7ff6cbcbaff8) }" -> "0x16a5d1c4250" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1c4250" -> "Pointer { addr: 0x16a5d1b2660, metadata: DynMetadata(0x7ff6cbcbaf88) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x16a5d1b2660, metadata: DynMetadata(0x7ff6cbcbaf88) }" -> "0x16a5d1c8210" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1c49d0" -> "Pointer { addr: 0x16a5d1b2480, metadata: DynMetadata(0x7ff6cbcbaf00) }" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1c8210" -> "Pointer { addr: 0x16a5d1b2480, metadata: DynMetadata(0x7ff6cbcbaf00) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x16a5d1b2480, metadata: DynMetadata(0x7ff6cbcbaf00) }" -> "0x16a5d1d0e60" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1cfd80" -> "Pointer { addr: 0x16a5d1b2510, metadata: DynMetadata(0x7ff6cbcbaff8) }" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1c4ed0" -> "Pointer { addr: 0x16a5d1b2510, metadata: DynMetadata(0x7ff6cbcbaff8) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x16a5d1b2510, metadata: DynMetadata(0x7ff6cbcbaff8) }" -> "0x16a5d1d0aa0" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1d0aa0" -> "Pointer { addr: 0x16a5d1b2540, metadata: DynMetadata(0x7ff6cbcbaf88) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x16a5d1b2540, metadata: DynMetadata(0x7ff6cbcbaf88) }" -> "0x16a5d1d0d20" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1d0e60" -> "Pointer { addr: 0x16a5d1b24b0, metadata: DynMetadata(0x7ff6cbcbaf50) }" [style=solid, color="#2E86AB", penwidth=2];
    "0x16a5d1d0d20" -> "Pointer { addr: 0x16a5d1b24b0, metadata: DynMetadata(0x7ff6cbcbaf50) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x16a5d1b24b0, metadata: DynMetadata(0x7ff6cbcbaf50) }" -> "0x16a5d1cf920" [style=solid, color="#2E86AB", penwidth=2];
}
