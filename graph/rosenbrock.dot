digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Add_5034ad61fef46d7b" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_c2d0d984d3280e4e" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(158)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(169)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(139)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(163)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(135)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Mul_ceb2c1f6b55452e2" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(165)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(167)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_5ec8e02f1c5d51b7" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_a0df05d7f4503203" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_2b676ce916fb5f4e" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_c4feac6635545073" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(171)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(148)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(160)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(154)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(135)"; "NodeId(139)"; }
    { rank=same; "NodeId(154)"; "NodeId(165)"; }
    { rank=source; "NodeId(139)"; "NodeId(135)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(135)" -> "Square_c2d0d984d3280e4e" [style=solid, color="#2E86AB", penwidth=2];
    "Square_c2d0d984d3280e4e" -> "NodeId(148)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(139)" -> "Sub_a0df05d7f4503203" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(148)" -> "Sub_a0df05d7f4503203" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_a0df05d7f4503203" -> "NodeId(158)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(158)" -> "Square_5ec8e02f1c5d51b7" [style=solid, color="#2E86AB", penwidth=2];
    "Square_5ec8e02f1c5d51b7" -> "NodeId(160)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(154)" -> "Mul_ceb2c1f6b55452e2" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(160)" -> "Mul_ceb2c1f6b55452e2" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_ceb2c1f6b55452e2" -> "NodeId(163)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(165)" -> "Sub_c4feac6635545073" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(135)" -> "Sub_c4feac6635545073" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_c4feac6635545073" -> "NodeId(167)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(167)" -> "Square_2b676ce916fb5f4e" [style=solid, color="#2E86AB", penwidth=2];
    "Square_2b676ce916fb5f4e" -> "NodeId(169)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(163)" -> "Add_5034ad61fef46d7b" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(169)" -> "Add_5034ad61fef46d7b" [style=solid, color="#2E86AB", penwidth=2];
    "Add_5034ad61fef46d7b" -> "NodeId(171)" [style=solid, color="#2E86AB", penwidth=2];
}
