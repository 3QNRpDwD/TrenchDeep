digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(8)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Square_7f15457dbf649c81" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(159)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "Sub_8f3231fac7d942d" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(132)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(40)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(150)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_7c9cb96786a293b9" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_df88909d29a65ede" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_cb919d261d8ddf2b" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(88)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_c07de653cc226793" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(126)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(110)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(1)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(96)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_8aa1018e98c6478e" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(73)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(8)"; "NodeId(1)"; }
    { rank=same; "NodeId(73)"; "NodeId(126)"; }
    { rank=source; "NodeId(8)"; "NodeId(1)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(1)" -> "Square_c07de653cc226793" [style=solid, color="#2E86AB", penwidth=2];
    "Square_c07de653cc226793" -> "NodeId(40)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(8)" -> "Sub_8f3231fac7d942d" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(40)" -> "Sub_8f3231fac7d942d" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_8f3231fac7d942d" -> "NodeId(88)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(88)" -> "Square_7f15457dbf649c81" [style=solid, color="#2E86AB", penwidth=2];
    "Square_7f15457dbf649c81" -> "NodeId(96)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(73)" -> "Mul_7c9cb96786a293b9" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(96)" -> "Mul_7c9cb96786a293b9" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_7c9cb96786a293b9" -> "NodeId(110)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(126)" -> "Sub_cb919d261d8ddf2b" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(1)" -> "Sub_cb919d261d8ddf2b" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_cb919d261d8ddf2b" -> "NodeId(132)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(132)" -> "Square_df88909d29a65ede" [style=solid, color="#2E86AB", penwidth=2];
    "Square_df88909d29a65ede" -> "NodeId(150)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(110)" -> "Add_8aa1018e98c6478e" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(150)" -> "Add_8aa1018e98c6478e" [style=solid, color="#2E86AB", penwidth=2];
    "Add_8aa1018e98c6478e" -> "NodeId(159)" [style=solid, color="#2E86AB", penwidth=2];
}
