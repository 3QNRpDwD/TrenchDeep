digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(42)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Square_72b62d19d6f29548" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(84)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(78)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(50)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(55)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(49)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_74358c3320967720" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(81)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_50ec396b2e0dd0c6" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_e28bbadc36305e5a" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_caddc2c979fb41bc" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(79)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(39)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Add_7b0da067e7d2a709" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(64)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(75)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_3c51465231834513" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    { rank=same; "NodeId(39)"; "NodeId(42)"; }
    { rank=same; "NodeId(78)"; "NodeId(49)"; }
    { rank=source; "NodeId(42)"; "NodeId(39)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(39)" -> "Square_3c51465231834513" [style=solid, color="#2E86AB", penwidth=2];
    "Square_3c51465231834513" -> "NodeId(50)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(42)" -> "Sub_caddc2c979fb41bc" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(50)" -> "Sub_caddc2c979fb41bc" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_caddc2c979fb41bc" -> "NodeId(55)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(55)" -> "Square_e28bbadc36305e5a" [style=solid, color="#2E86AB", penwidth=2];
    "Square_e28bbadc36305e5a" -> "NodeId(64)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(49)" -> "Mul_74358c3320967720" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(64)" -> "Mul_74358c3320967720" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_74358c3320967720" -> "NodeId(75)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(78)" -> "Sub_50ec396b2e0dd0c6" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(39)" -> "Sub_50ec396b2e0dd0c6" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_50ec396b2e0dd0c6" -> "NodeId(79)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(79)" -> "Square_72b62d19d6f29548" [style=solid, color="#2E86AB", penwidth=2];
    "Square_72b62d19d6f29548" -> "NodeId(81)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(75)" -> "Add_7b0da067e7d2a709" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(81)" -> "Add_7b0da067e7d2a709" [style=solid, color="#2E86AB", penwidth=2];
    "Add_7b0da067e7d2a709" -> "NodeId(84)" [style=solid, color="#2E86AB", penwidth=2];
}
