digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "NodeId(44)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(58)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1b638d7b090, metadata: DynMetadata(0x7ff7a8420c70) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1b638d43830, metadata: DynMetadata(0x7ff7a8420c70) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1b638d6bbc0, metadata: DynMetadata(0x7ff7a8420da0) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1b638d7c0a0, metadata: DynMetadata(0x7ff7a8420cc0) }" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(19)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1b638d6ba40, metadata: DynMetadata(0x7ff7a8420c70) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1b638d7b120, metadata: DynMetadata(0x7ff7a8420da0) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(17)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "Pointer { addr: 0x1b638d7b060, metadata: DynMetadata(0x7ff7a8420cf8) }" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(37)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(26)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(43)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(51)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(16)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(23)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(18)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    { rank=source; "NodeId(17)"; "NodeId(43)"; "NodeId(16)"; "NodeId(18)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(16)" -> "Pointer { addr: 0x1b638d43830, metadata: DynMetadata(0x7ff7a8420c70) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1b638d43830, metadata: DynMetadata(0x7ff7a8420c70) }" -> "NodeId(19)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(17)" -> "Pointer { addr: 0x1b638d6bbc0, metadata: DynMetadata(0x7ff7a8420da0) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(19)" -> "Pointer { addr: 0x1b638d6bbc0, metadata: DynMetadata(0x7ff7a8420da0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1b638d6bbc0, metadata: DynMetadata(0x7ff7a8420da0) }" -> "NodeId(23)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(23)" -> "Pointer { addr: 0x1b638d6ba40, metadata: DynMetadata(0x7ff7a8420c70) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1b638d6ba40, metadata: DynMetadata(0x7ff7a8420c70) }" -> "NodeId(26)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(18)" -> "Pointer { addr: 0x1b638d7b060, metadata: DynMetadata(0x7ff7a8420cf8) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(26)" -> "Pointer { addr: 0x1b638d7b060, metadata: DynMetadata(0x7ff7a8420cf8) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1b638d7b060, metadata: DynMetadata(0x7ff7a8420cf8) }" -> "NodeId(37)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(43)" -> "Pointer { addr: 0x1b638d7b120, metadata: DynMetadata(0x7ff7a8420da0) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(16)" -> "Pointer { addr: 0x1b638d7b120, metadata: DynMetadata(0x7ff7a8420da0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1b638d7b120, metadata: DynMetadata(0x7ff7a8420da0) }" -> "NodeId(44)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(44)" -> "Pointer { addr: 0x1b638d7b090, metadata: DynMetadata(0x7ff7a8420c70) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1b638d7b090, metadata: DynMetadata(0x7ff7a8420c70) }" -> "NodeId(51)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(37)" -> "Pointer { addr: 0x1b638d7c0a0, metadata: DynMetadata(0x7ff7a8420cc0) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(51)" -> "Pointer { addr: 0x1b638d7c0a0, metadata: DynMetadata(0x7ff7a8420cc0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1b638d7c0a0, metadata: DynMetadata(0x7ff7a8420cc0) }" -> "NodeId(58)" [style=solid, color="#2E86AB", penwidth=2];
}
