digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Sub_b0ce454d012c4b26" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_4deeaac6642e3f8e" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Mul_8d132a4918326fc5" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_45dc7c83e20c1a6" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(22)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(8)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(34)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_b9cf10e5ed34c10d" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(2)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(41)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(37)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(39)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(11)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(3)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(32)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_d5b12f4b94d0cf5c" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_921c2915bc0c1323" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(36)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(36)"; "NodeId(8)"; }
    { rank=source; "NodeId(2)"; "NodeId(3)"; }
    { rank=sink; "NodeId(41)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(2)" -> "Square_45dc7c83e20c1a6" [style=solid, color="#2E86AB", penwidth=2];
    "Square_45dc7c83e20c1a6" -> "NodeId(11)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(3)" -> "Sub_b0ce454d012c4b26" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(11)" -> "Sub_b0ce454d012c4b26" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_b0ce454d012c4b26" -> "NodeId(22)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(22)" -> "Square_4deeaac6642e3f8e" [style=solid, color="#2E86AB", penwidth=2];
    "Square_4deeaac6642e3f8e" -> "NodeId(32)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(8)" -> "Mul_8d132a4918326fc5" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(32)" -> "Mul_8d132a4918326fc5" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_8d132a4918326fc5" -> "NodeId(34)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(36)" -> "Sub_921c2915bc0c1323" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2)" -> "Sub_921c2915bc0c1323" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_921c2915bc0c1323" -> "NodeId(37)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(37)" -> "Square_b9cf10e5ed34c10d" [style=solid, color="#2E86AB", penwidth=2];
    "Square_b9cf10e5ed34c10d" -> "NodeId(39)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(34)" -> "Add_d5b12f4b94d0cf5c" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(39)" -> "Add_d5b12f4b94d0cf5c" [style=solid, color="#2E86AB", penwidth=2];
    "Add_d5b12f4b94d0cf5c" -> "NodeId(41)" [style=solid, color="#2E86AB", penwidth=2];
}
