digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(100)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_718abc3b2dfbbe64" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(67)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(145)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_c1f776a88a0cda4f" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_ef1b27201efa6d43" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(157)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_e616030c2726dbd9" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(14)" [label="input_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_248ef32d63fe518a" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_d40a473fd2710c88" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_ba6daf62d25f6ef1" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(12)" [label="input", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(164)" [label="output", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(108)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(97)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(134)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(124)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(12)"; "NodeId(97)"; "NodeId(134)"; "NodeId(14)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(12)" -> "Square_c1f776a88a0cda4f" [style=solid, color="#2E86AB", penwidth=2];
    "Square_c1f776a88a0cda4f" -> "NodeId(67)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(14)" -> "Sub_248ef32d63fe518a" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(67)" -> "Sub_248ef32d63fe518a" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_248ef32d63fe518a" -> "NodeId(100)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(100)" -> "Square_ba6daf62d25f6ef1" [style=solid, color="#2E86AB", penwidth=2];
    "Square_ba6daf62d25f6ef1" -> "NodeId(108)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(97)" -> "Mul_718abc3b2dfbbe64" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(108)" -> "Mul_718abc3b2dfbbe64" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_718abc3b2dfbbe64" -> "NodeId(124)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(134)" -> "Sub_d40a473fd2710c88" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(12)" -> "Sub_d40a473fd2710c88" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_d40a473fd2710c88" -> "NodeId(145)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(145)" -> "Square_ef1b27201efa6d43" [style=solid, color="#2E86AB", penwidth=2];
    "Square_ef1b27201efa6d43" -> "NodeId(157)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(124)" -> "Add_e616030c2726dbd9" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(157)" -> "Add_e616030c2726dbd9" [style=solid, color="#2E86AB", penwidth=2];
    "Add_e616030c2726dbd9" -> "NodeId(164)" [style=solid, color="#2E86AB", penwidth=2];
}
