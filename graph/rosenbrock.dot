digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(461)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_2bd9073e82fe8964" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_a449a5ebab4db8a2" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(445)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(459)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_992511dcbd0200c9" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(457)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(456)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_747beadbd1b161a3" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(455)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(458)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(463)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(448)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Mul_cbc953c2279aac76" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Add_4c650e92590bbf6a" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(460)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_d6e5d17c29321f6d" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(462)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(445)"; "NodeId(448)"; }
    { rank=same; "NodeId(455)"; "NodeId(460)"; }
    { rank=source; "NodeId(445)"; "NodeId(448)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(445)" -> "Square_d6e5d17c29321f6d" [style=solid, color="#2E86AB", penwidth=2];
    "Square_d6e5d17c29321f6d" -> "NodeId(456)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(448)" -> "Sub_2bd9073e82fe8964" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(456)" -> "Sub_2bd9073e82fe8964" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_2bd9073e82fe8964" -> "NodeId(457)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(457)" -> "Square_a449a5ebab4db8a2" [style=solid, color="#2E86AB", penwidth=2];
    "Square_a449a5ebab4db8a2" -> "NodeId(458)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(455)" -> "Mul_cbc953c2279aac76" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(458)" -> "Mul_cbc953c2279aac76" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_cbc953c2279aac76" -> "NodeId(459)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(460)" -> "Sub_747beadbd1b161a3" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(445)" -> "Sub_747beadbd1b161a3" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_747beadbd1b161a3" -> "NodeId(461)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(461)" -> "Square_992511dcbd0200c9" [style=solid, color="#2E86AB", penwidth=2];
    "Square_992511dcbd0200c9" -> "NodeId(462)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(459)" -> "Add_4c650e92590bbf6a" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(462)" -> "Add_4c650e92590bbf6a" [style=solid, color="#2E86AB", penwidth=2];
    "Add_4c650e92590bbf6a" -> "NodeId(463)" [style=solid, color="#2E86AB", penwidth=2];
}
