digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "NodeId(2187176265440)" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(2187176142432)" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(75)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(41)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(63)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(43)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(83)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(45)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(71)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(57)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(51)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(2187176153888)" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(2187176265200)" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(2187176265680)" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(2187176154176)" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(77)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(2187176265104)" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(46)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    { rank=source; "NodeId(41)"; "NodeId(43)"; "NodeId(45)"; "NodeId(71)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(41)" -> "NodeId(2187176154176)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2187176154176)" -> "NodeId(46)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(43)" -> "NodeId(2187176153888)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(46)" -> "NodeId(2187176153888)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2187176153888)" -> "NodeId(51)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(51)" -> "NodeId(2187176265104)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2187176265104)" -> "NodeId(57)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(45)" -> "NodeId(2187176265440)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(57)" -> "NodeId(2187176265440)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2187176265440)" -> "NodeId(63)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(71)" -> "NodeId(2187176265200)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(41)" -> "NodeId(2187176265200)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2187176265200)" -> "NodeId(75)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(75)" -> "NodeId(2187176265680)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2187176265680)" -> "NodeId(77)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(63)" -> "NodeId(2187176142432)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(77)" -> "NodeId(2187176142432)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2187176142432)" -> "NodeId(83)" [style=solid, color="#2E86AB", penwidth=2];
}
