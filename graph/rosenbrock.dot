digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(120)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "Mul_a4e64efb4ce3011b" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_5f18e75af799e7b" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(91)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_f7a89bd4677c72d4" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_a3256b1ca4904a6f" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_c954ec096f82f345" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(75)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(109)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(102)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(34)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(68)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_ddde0751317b047b" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(63)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(96)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(36)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(85)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_333646a28e1bdb97" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    { rank=same; "NodeId(34)"; "NodeId(36)"; }
    { rank=same; "NodeId(96)"; "NodeId(68)"; }
    { rank=source; "NodeId(34)"; "NodeId(36)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(34)" -> "Square_f7a89bd4677c72d4" [style=solid, color="#2E86AB", penwidth=2];
    "Square_f7a89bd4677c72d4" -> "NodeId(63)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(36)" -> "Sub_c954ec096f82f345" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(63)" -> "Sub_c954ec096f82f345" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_c954ec096f82f345" -> "NodeId(75)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(75)" -> "Square_a3256b1ca4904a6f" [style=solid, color="#2E86AB", penwidth=2];
    "Square_a3256b1ca4904a6f" -> "NodeId(85)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(68)" -> "Mul_a4e64efb4ce3011b" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(85)" -> "Mul_a4e64efb4ce3011b" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_a4e64efb4ce3011b" -> "NodeId(91)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(96)" -> "Sub_5f18e75af799e7b" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(34)" -> "Sub_5f18e75af799e7b" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_5f18e75af799e7b" -> "NodeId(102)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(102)" -> "Square_ddde0751317b047b" [style=solid, color="#2E86AB", penwidth=2];
    "Square_ddde0751317b047b" -> "NodeId(109)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(91)" -> "Add_333646a28e1bdb97" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(109)" -> "Add_333646a28e1bdb97" [style=solid, color="#2E86AB", penwidth=2];
    "Add_333646a28e1bdb97" -> "NodeId(120)" [style=solid, color="#2E86AB", penwidth=2];
}
