digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(45)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(148)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(103)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_c0b1e0adfea90142" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_3843d7b2b0d28897" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(135)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(75)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_c2d0d984d3280e4e" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(117)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(48)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(58)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_86c24bd41aee400d" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(127)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(141)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_9f29c9a716211351" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_cb9163f33157025d" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(95)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_7c73559afdedfb35" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    { rank=same; "NodeId(48)"; "NodeId(45)"; }
    { rank=same; "NodeId(75)"; "NodeId(127)"; }
    { rank=source; "NodeId(45)"; "NodeId(48)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(45)" -> "Square_cb9163f33157025d" [style=solid, color="#2E86AB", penwidth=2];
    "Square_cb9163f33157025d" -> "NodeId(58)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(48)" -> "Sub_86c24bd41aee400d" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(58)" -> "Sub_86c24bd41aee400d" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_86c24bd41aee400d" -> "NodeId(95)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(95)" -> "Square_3843d7b2b0d28897" [style=solid, color="#2E86AB", penwidth=2];
    "Square_3843d7b2b0d28897" -> "NodeId(103)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(75)" -> "Mul_7c73559afdedfb35" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(103)" -> "Mul_7c73559afdedfb35" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_7c73559afdedfb35" -> "NodeId(117)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(127)" -> "Sub_c0b1e0adfea90142" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(45)" -> "Sub_c0b1e0adfea90142" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_c0b1e0adfea90142" -> "NodeId(135)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(135)" -> "Square_c2d0d984d3280e4e" [style=solid, color="#2E86AB", penwidth=2];
    "Square_c2d0d984d3280e4e" -> "NodeId(141)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(117)" -> "Add_9f29c9a716211351" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(141)" -> "Add_9f29c9a716211351" [style=solid, color="#2E86AB", penwidth=2];
    "Add_9f29c9a716211351" -> "NodeId(148)" [style=solid, color="#2E86AB", penwidth=2];
}
