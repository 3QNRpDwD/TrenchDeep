digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Square_6bda5221945ea049" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(112)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_d88ae0e2cc8d4257" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(3)" [label="input", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(127)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(187)" [label="output", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(124)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(60)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(86)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(175)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_ef02e115bdf53202" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(16)" [label="input_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_d86c56766736d2c8" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_3df6006d3361684a" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_9959ced36e0499ed" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Mul_182a33be9423a9d0" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(93)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(134)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(127)"; "NodeId(86)"; "NodeId(3)"; "NodeId(16)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(3)" -> "Square_9959ced36e0499ed" [style=solid, color="#2E86AB", penwidth=2];
    "Square_9959ced36e0499ed" -> "NodeId(60)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(16)" -> "Sub_3df6006d3361684a" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(60)" -> "Sub_3df6006d3361684a" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_3df6006d3361684a" -> "NodeId(93)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(93)" -> "Square_d88ae0e2cc8d4257" [style=solid, color="#2E86AB", penwidth=2];
    "Square_d88ae0e2cc8d4257" -> "NodeId(112)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(86)" -> "Mul_182a33be9423a9d0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(112)" -> "Mul_182a33be9423a9d0" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_182a33be9423a9d0" -> "NodeId(124)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(127)" -> "Sub_d86c56766736d2c8" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(3)" -> "Sub_d86c56766736d2c8" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_d86c56766736d2c8" -> "NodeId(134)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(134)" -> "Square_6bda5221945ea049" [style=solid, color="#2E86AB", penwidth=2];
    "Square_6bda5221945ea049" -> "NodeId(175)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(124)" -> "Add_ef02e115bdf53202" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(175)" -> "Add_ef02e115bdf53202" [style=solid, color="#2E86AB", penwidth=2];
    "Add_ef02e115bdf53202" -> "NodeId(187)" [style=solid, color="#2E86AB", penwidth=2];
}
