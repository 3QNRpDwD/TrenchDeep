digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.0;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Mul_1f669918b8674fb6" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(74)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(11)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Sub_d86d2b5bd0989052" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(68)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_362a8991c3668070" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_51693f28790c32e5" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Add_ddc11817fb85261d" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(70)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(29)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(9)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Square_ebb39575b6f8dc0d" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(44)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(28)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(46)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(73)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(27)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_5b515f4a67cfb1aa" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    { rank=source; "NodeId(11)"; "NodeId(9)"; }
    { rank=sink; "NodeId(74)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(9)" -> "Square_ebb39575b6f8dc0d" [style=solid, color="#2E86AB", penwidth=2];
    "Square_ebb39575b6f8dc0d" -> "NodeId(28)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(11)" -> "Sub_362a8991c3668070" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(28)" -> "Sub_362a8991c3668070" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_362a8991c3668070" -> "NodeId(29)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(29)" -> "Square_51693f28790c32e5" [style=solid, color="#2E86AB", penwidth=2];
    "Square_51693f28790c32e5" -> "NodeId(44)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(27)" -> "Mul_1f669918b8674fb6" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(44)" -> "Mul_1f669918b8674fb6" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_1f669918b8674fb6" -> "NodeId(46)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(68)" -> "Sub_d86d2b5bd0989052" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(9)" -> "Sub_d86d2b5bd0989052" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_d86d2b5bd0989052" -> "NodeId(70)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(70)" -> "Square_5b515f4a67cfb1aa" [style=solid, color="#2E86AB", penwidth=2];
    "Square_5b515f4a67cfb1aa" -> "NodeId(73)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(46)" -> "Add_ddc11817fb85261d" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(73)" -> "Add_ddc11817fb85261d" [style=solid, color="#2E86AB", penwidth=2];
    "Add_ddc11817fb85261d" -> "NodeId(74)" [style=solid, color="#2E86AB", penwidth=2];
}
