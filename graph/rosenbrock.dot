digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(285)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(290)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(298)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(280)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(294)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(287)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(282)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(296)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_284461257565f872" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Mul_83814de5f93a7983" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(292)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_7e62a73c0318b710" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_a093d7e9113f81ac" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_a726aa97763deca4" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_2b76bee1aeca791d" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_787605713b2bdb3b" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(276)" [label="x1", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(274)" [label="x0", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(274)"; "NodeId(282)"; "NodeId(292)"; "NodeId(276)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(274)" -> "Square_a093d7e9113f81ac" [style=solid, color="#2E86AB", penwidth=2];
    "Square_a093d7e9113f81ac" -> "NodeId(280)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(276)" -> "Sub_7e62a73c0318b710" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(280)" -> "Sub_7e62a73c0318b710" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_7e62a73c0318b710" -> "NodeId(285)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(285)" -> "Square_2b76bee1aeca791d" [style=solid, color="#2E86AB", penwidth=2];
    "Square_2b76bee1aeca791d" -> "NodeId(287)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(282)" -> "Mul_83814de5f93a7983" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(287)" -> "Mul_83814de5f93a7983" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_83814de5f93a7983" -> "NodeId(290)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(292)" -> "Sub_787605713b2bdb3b" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(274)" -> "Sub_787605713b2bdb3b" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_787605713b2bdb3b" -> "NodeId(294)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(294)" -> "Square_a726aa97763deca4" [style=solid, color="#2E86AB", penwidth=2];
    "Square_a726aa97763deca4" -> "NodeId(296)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(290)" -> "Add_284461257565f872" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(296)" -> "Add_284461257565f872" [style=solid, color="#2E86AB", penwidth=2];
    "Add_284461257565f872" -> "NodeId(298)" [style=solid, color="#2E86AB", penwidth=2];
}
