digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Mul_928c3f07a01fe4b3" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(58)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Sub_eb213dc3db2a316b" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(62)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(94)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(99)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_87d16798d1d34d2e" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(103)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "Square_d9d83588b7fc14ef" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_39128a08dfb7e4c" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_9407fb5a1c1e000f" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(102)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_7fbf4ca03508d17e" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(88)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(80)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(98)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(69)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(72)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(58)"; "NodeId(62)"; }
    { rank=same; "NodeId(98)"; "NodeId(69)"; }
    { rank=source; "NodeId(58)"; "NodeId(62)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(58)" -> "Square_d9d83588b7fc14ef" [style=solid, color="#2E86AB", penwidth=2];
    "Square_d9d83588b7fc14ef" -> "NodeId(72)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(62)" -> "Sub_39128a08dfb7e4c" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(72)" -> "Sub_39128a08dfb7e4c" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_39128a08dfb7e4c" -> "NodeId(80)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(80)" -> "Square_9407fb5a1c1e000f" [style=solid, color="#2E86AB", penwidth=2];
    "Square_9407fb5a1c1e000f" -> "NodeId(88)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(69)" -> "Mul_928c3f07a01fe4b3" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(88)" -> "Mul_928c3f07a01fe4b3" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_928c3f07a01fe4b3" -> "NodeId(94)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(98)" -> "Sub_eb213dc3db2a316b" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(58)" -> "Sub_eb213dc3db2a316b" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_eb213dc3db2a316b" -> "NodeId(99)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(99)" -> "Square_87d16798d1d34d2e" [style=solid, color="#2E86AB", penwidth=2];
    "Square_87d16798d1d34d2e" -> "NodeId(102)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(94)" -> "Add_7fbf4ca03508d17e" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(102)" -> "Add_7fbf4ca03508d17e" [style=solid, color="#2E86AB", penwidth=2];
    "Add_7fbf4ca03508d17e" -> "NodeId(103)" [style=solid, color="#2E86AB", penwidth=2];
}
