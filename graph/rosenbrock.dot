digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "NodeId(232)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(199)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(240)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(241)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(258)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x2893a8ae070" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x2893a8b2400" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(253)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x2893a8ae010" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x2893a8b23d0" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(217)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(198)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x2893a8b1b30" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x2893a8b1f50" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x2893a8b1cb0" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(220)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(227)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(242)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    { rank=source; "NodeId(199)"; "NodeId(241)"; "NodeId(217)"; "NodeId(198)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(198)" -> "0x2893a8b2400" [style=solid, color="#2E86AB", penwidth=2];
    "0x2893a8b2400" -> "NodeId(220)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(199)" -> "0x2893a8b23d0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(220)" -> "0x2893a8b23d0" [style=solid, color="#2E86AB", penwidth=2];
    "0x2893a8b23d0" -> "NodeId(227)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(227)" -> "0x2893a8ae010" [style=solid, color="#2E86AB", penwidth=2];
    "0x2893a8ae010" -> "NodeId(232)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(217)" -> "0x2893a8ae070" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(232)" -> "0x2893a8ae070" [style=solid, color="#2E86AB", penwidth=2];
    "0x2893a8ae070" -> "NodeId(240)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(241)" -> "0x2893a8b1f50" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(198)" -> "0x2893a8b1f50" [style=solid, color="#2E86AB", penwidth=2];
    "0x2893a8b1f50" -> "NodeId(242)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(242)" -> "0x2893a8b1b30" [style=solid, color="#2E86AB", penwidth=2];
    "0x2893a8b1b30" -> "NodeId(253)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(240)" -> "0x2893a8b1cb0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(253)" -> "0x2893a8b1cb0" [style=solid, color="#2E86AB", penwidth=2];
    "0x2893a8b1cb0" -> "NodeId(258)" [style=solid, color="#2E86AB", penwidth=2];
}
