digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "Pointer { addr: 0x1d5a8d613c0, metadata: DynMetadata(0x7ff7d14a3060) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(0)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(2)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(41)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(5)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(23)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1d5a8d61210, metadata: DynMetadata(0x7ff7d14a2f30) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1d5a8d593d0, metadata: DynMetadata(0x7ff7d14a2f30) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(28)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1d5a8d59490, metadata: DynMetadata(0x7ff7d14a2fb8) }" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(1)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(32)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1d5a8d3e660, metadata: DynMetadata(0x7ff7d14a3060) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(38)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1d5a8d61390, metadata: DynMetadata(0x7ff7d14a2f80) }" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(37)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(47)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1d5a8d10950, metadata: DynMetadata(0x7ff7d14a2f30) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    { rank=source; "NodeId(0)"; "NodeId(2)"; "NodeId(1)"; "NodeId(37)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(0)" -> "Pointer { addr: 0x1d5a8d10950, metadata: DynMetadata(0x7ff7d14a2f30) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1d5a8d10950, metadata: DynMetadata(0x7ff7d14a2f30) }" -> "NodeId(5)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(1)" -> "Pointer { addr: 0x1d5a8d3e660, metadata: DynMetadata(0x7ff7d14a3060) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(5)" -> "Pointer { addr: 0x1d5a8d3e660, metadata: DynMetadata(0x7ff7d14a3060) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1d5a8d3e660, metadata: DynMetadata(0x7ff7d14a3060) }" -> "NodeId(23)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(23)" -> "Pointer { addr: 0x1d5a8d593d0, metadata: DynMetadata(0x7ff7d14a2f30) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1d5a8d593d0, metadata: DynMetadata(0x7ff7d14a2f30) }" -> "NodeId(28)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2)" -> "Pointer { addr: 0x1d5a8d59490, metadata: DynMetadata(0x7ff7d14a2fb8) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(28)" -> "Pointer { addr: 0x1d5a8d59490, metadata: DynMetadata(0x7ff7d14a2fb8) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1d5a8d59490, metadata: DynMetadata(0x7ff7d14a2fb8) }" -> "NodeId(32)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(37)" -> "Pointer { addr: 0x1d5a8d613c0, metadata: DynMetadata(0x7ff7d14a3060) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(0)" -> "Pointer { addr: 0x1d5a8d613c0, metadata: DynMetadata(0x7ff7d14a3060) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1d5a8d613c0, metadata: DynMetadata(0x7ff7d14a3060) }" -> "NodeId(38)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(38)" -> "Pointer { addr: 0x1d5a8d61210, metadata: DynMetadata(0x7ff7d14a2f30) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1d5a8d61210, metadata: DynMetadata(0x7ff7d14a2f30) }" -> "NodeId(41)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(32)" -> "Pointer { addr: 0x1d5a8d61390, metadata: DynMetadata(0x7ff7d14a2f80) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(41)" -> "Pointer { addr: 0x1d5a8d61390, metadata: DynMetadata(0x7ff7d14a2f80) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1d5a8d61390, metadata: DynMetadata(0x7ff7d14a2f80) }" -> "NodeId(47)" [style=solid, color="#2E86AB", penwidth=2];
}
