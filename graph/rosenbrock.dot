digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Sub_7b34893503b671a" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(58)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_581c13830f34fe10" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(73)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(84)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "Sub_761b7b48cb2d35e8" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Add_db533a5a00c05c8d" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(63)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_d9d83588b7fc14ef" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(54)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(80)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(51)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(77)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(47)" [label="x1", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(44)" [label="x0", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_82840ecaf1919212" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Mul_e623c9f221bd528d" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(70)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(44)"; "NodeId(54)"; "NodeId(73)"; "NodeId(47)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(44)" -> "Square_581c13830f34fe10" [style=solid, color="#2E86AB", penwidth=2];
    "Square_581c13830f34fe10" -> "NodeId(51)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(47)" -> "Sub_761b7b48cb2d35e8" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(51)" -> "Sub_761b7b48cb2d35e8" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_761b7b48cb2d35e8" -> "NodeId(58)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(58)" -> "Square_d9d83588b7fc14ef" [style=solid, color="#2E86AB", penwidth=2];
    "Square_d9d83588b7fc14ef" -> "NodeId(63)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(54)" -> "Mul_e623c9f221bd528d" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(63)" -> "Mul_e623c9f221bd528d" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_e623c9f221bd528d" -> "NodeId(70)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(73)" -> "Sub_7b34893503b671a" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(44)" -> "Sub_7b34893503b671a" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_7b34893503b671a" -> "NodeId(77)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(77)" -> "Square_82840ecaf1919212" [style=solid, color="#2E86AB", penwidth=2];
    "Square_82840ecaf1919212" -> "NodeId(80)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(70)" -> "Add_db533a5a00c05c8d" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(80)" -> "Add_db533a5a00c05c8d" [style=solid, color="#2E86AB", penwidth=2];
    "Add_db533a5a00c05c8d" -> "NodeId(84)" [style=solid, color="#2E86AB", penwidth=2];
}
