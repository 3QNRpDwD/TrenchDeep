digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(257)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(244)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(255)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_eb98aa8da6d98977" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(267)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(246)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Square_cc8810c71252ae34" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Mul_64a3d878ededf106" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Add_1ef306e67ff9a456" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Sub_37311174970ac98e" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(341)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(250)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(261)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_9bf2a2c1fda31ce0" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(275)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(252)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_3b5e5b9534b95710" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(271)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(244)"; "NodeId(246)"; }
    { rank=same; "NodeId(267)"; "NodeId(252)"; }
    { rank=source; "NodeId(244)"; "NodeId(246)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(244)" -> "Square_eb98aa8da6d98977" [style=solid, color="#2E86AB", penwidth=2];
    "Square_eb98aa8da6d98977" -> "NodeId(250)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(246)" -> "Sub_37311174970ac98e" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(250)" -> "Sub_37311174970ac98e" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_37311174970ac98e" -> "NodeId(255)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(255)" -> "Square_3b5e5b9534b95710" [style=solid, color="#2E86AB", penwidth=2];
    "Square_3b5e5b9534b95710" -> "NodeId(257)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(252)" -> "Mul_64a3d878ededf106" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(257)" -> "Mul_64a3d878ededf106" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_64a3d878ededf106" -> "NodeId(261)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(267)" -> "Sub_9bf2a2c1fda31ce0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(244)" -> "Sub_9bf2a2c1fda31ce0" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_9bf2a2c1fda31ce0" -> "NodeId(271)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(271)" -> "Square_cc8810c71252ae34" [style=solid, color="#2E86AB", penwidth=2];
    "Square_cc8810c71252ae34" -> "NodeId(275)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(261)" -> "Add_1ef306e67ff9a456" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(275)" -> "Add_1ef306e67ff9a456" [style=solid, color="#2E86AB", penwidth=2];
    "Add_1ef306e67ff9a456" -> "NodeId(341)" [style=solid, color="#2E86AB", penwidth=2];
}
