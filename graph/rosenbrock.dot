digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "0x1455b5e8800" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x1455b5e87a0" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x1455b608d10" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1455b609490" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x1455b617400" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1455b6179a0" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1455b61d5c0" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x1455b5e8830" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x1455b617a40" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1455b61d2c0" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x1455b608c70" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1455b608950" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x1455b6175e0" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1455b617900" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x1455b61d020" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x1455b60a680" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x1455b617ae0" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x1455b5e8ce0" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    { rank=source; "0x1455b609490"; "0x1455b608950"; "0x1455b617900"; "0x1455b60a680"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "0x1455b60a680" -> "0x1455b5e8830" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b5e8830" -> "0x1455b608c70" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b608950" -> "0x1455b5e87a0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b608c70" -> "0x1455b5e87a0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b5e87a0" -> "0x1455b608d10" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b608d10" -> "0x1455b5e8800" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b5e8800" -> "0x1455b617a40" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b609490" -> "0x1455b5e8ce0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b617a40" -> "0x1455b5e8ce0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b5e8ce0" -> "0x1455b617ae0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b617900" -> "0x1455b61d2c0" [style=solid, color="#2E86AB", penwidth=2];
    "0x1455b60a680" -> "0x1455b61d2c0" [style=solid, color="#2E86AB", penwidth=2];
