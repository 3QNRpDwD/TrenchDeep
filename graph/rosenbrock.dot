digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Sub_b092a735e6a87068" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(103)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_7153f07a1eceb188" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(172)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(150)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_3fcc69a23d3ee552" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(8)" [label="x0", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(160)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_cbe340e4066dcb7e" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_f5578f83294848da" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(13)" [label="x1", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(73)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(163)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(155)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_db84b1ad338eefb7" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(33)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(133)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Mul_cd1f34f47d85cd68" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    { rank=same; "NodeId(8)"; "NodeId(13)"; "NodeId(73)"; "NodeId(155)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(8)" -> "Square_cbe340e4066dcb7e" [style=solid, color="#2E86AB", penwidth=2];
    "Square_cbe340e4066dcb7e" -> "NodeId(33)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(13)" -> "Sub_b092a735e6a87068" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(33)" -> "Sub_b092a735e6a87068" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_b092a735e6a87068" -> "NodeId(103)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(103)" -> "Square_3fcc69a23d3ee552" [style=solid, color="#2E86AB", penwidth=2];
    "Square_3fcc69a23d3ee552" -> "NodeId(133)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(73)" -> "Mul_cd1f34f47d85cd68" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(133)" -> "Mul_cd1f34f47d85cd68" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_cd1f34f47d85cd68" -> "NodeId(150)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(155)" -> "Sub_db84b1ad338eefb7" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(8)" -> "Sub_db84b1ad338eefb7" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_db84b1ad338eefb7" -> "NodeId(160)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(160)" -> "Square_f5578f83294848da" [style=solid, color="#2E86AB", penwidth=2];
    "Square_f5578f83294848da" -> "NodeId(163)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(150)" -> "Add_7153f07a1eceb188" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(163)" -> "Add_7153f07a1eceb188" [style=solid, color="#2E86AB", penwidth=2];
    "Add_7153f07a1eceb188" -> "NodeId(172)" [style=solid, color="#2E86AB", penwidth=2];
}
