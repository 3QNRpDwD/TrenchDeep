digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(29)" [label="input", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(66)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_55461861f5c1b6ba" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Mul_833100ee5a0008ab" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(138)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(93)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(32)" [label="input_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(102)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_59eb7a52908e5da2" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_51693f28790c32e5" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(44)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_1df056ec91040219" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(57)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(119)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(129)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_c018bc88e3ca5b2f" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Add_2e687d4ec0198179" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(161)" [label="output", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(57)"; "NodeId(32)"; "NodeId(29)"; "NodeId(119)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(29)" -> "Square_51693f28790c32e5" [style=solid, color="#2E86AB", penwidth=2];
    "Square_51693f28790c32e5" -> "NodeId(44)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(32)" -> "Sub_1df056ec91040219" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(44)" -> "Sub_1df056ec91040219" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_1df056ec91040219" -> "NodeId(66)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(66)" -> "Square_59eb7a52908e5da2" [style=solid, color="#2E86AB", penwidth=2];
    "Square_59eb7a52908e5da2" -> "NodeId(93)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(57)" -> "Mul_833100ee5a0008ab" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(93)" -> "Mul_833100ee5a0008ab" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_833100ee5a0008ab" -> "NodeId(102)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(119)" -> "Sub_55461861f5c1b6ba" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(29)" -> "Sub_55461861f5c1b6ba" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_55461861f5c1b6ba" -> "NodeId(129)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(129)" -> "Square_c018bc88e3ca5b2f" [style=solid, color="#2E86AB", penwidth=2];
    "Square_c018bc88e3ca5b2f" -> "NodeId(138)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(102)" -> "Add_2e687d4ec0198179" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(138)" -> "Add_2e687d4ec0198179" [style=solid, color="#2E86AB", penwidth=2];
    "Add_2e687d4ec0198179" -> "NodeId(161)" [style=solid, color="#2E86AB", penwidth=2];
}
