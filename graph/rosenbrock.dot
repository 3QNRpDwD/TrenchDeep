digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "NodeId(13)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x265653e5b00" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(0)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(7)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(11)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(8)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(12)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x265653e5ef0" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(1)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x265653e5a10" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(6)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x265653e6070" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x265653e5cb0" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x265653e5d70" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(10)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x265653e5c20" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(14)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(9)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    { rank=source; "NodeId(0)"; "NodeId(11)"; "NodeId(1)"; "NodeId(6)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(0)" -> "0x265653e5a10" [style=solid, color="#2E86AB", penwidth=2];
    "0x265653e5a10" -> "NodeId(7)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(1)" -> "0x265653e5d70" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(7)" -> "0x265653e5d70" [style=solid, color="#2E86AB", penwidth=2];
    "0x265653e5d70" -> "NodeId(8)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(8)" -> "0x265653e6070" [style=solid, color="#2E86AB", penwidth=2];
    "0x265653e6070" -> "NodeId(9)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(6)" -> "0x265653e5cb0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(9)" -> "0x265653e5cb0" [style=solid, color="#2E86AB", penwidth=2];
    "0x265653e5cb0" -> "NodeId(10)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(11)" -> "0x265653e5b00" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(0)" -> "0x265653e5b00" [style=solid, color="#2E86AB", penwidth=2];
    "0x265653e5b00" -> "NodeId(12)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(12)" -> "0x265653e5c20" [style=solid, color="#2E86AB", penwidth=2];
    "0x265653e5c20" -> "NodeId(13)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(10)" -> "0x265653e5ef0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(13)" -> "0x265653e5ef0" [style=solid, color="#2E86AB", penwidth=2];
    "0x265653e5ef0" -> "NodeId(14)" [style=solid, color="#2E86AB", penwidth=2];
}
