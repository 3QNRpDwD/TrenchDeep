digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "NodeId(77)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(73)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x199e3464f80" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x199e3499880" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(82)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(76)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x199e3464e90" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(80)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(81)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x199e3465010" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(74)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(83)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(78)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "0x199e3464e00" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "0x199e3464e60" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(75)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "0x199e34998e0" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(79)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    { rank=source; "NodeId(73)"; "NodeId(80)"; "NodeId(74)"; "NodeId(75)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(73)" -> "0x199e34998e0" [style=solid, color="#2E86AB", penwidth=2];
    "0x199e34998e0" -> "NodeId(76)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(74)" -> "0x199e3499880" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(76)" -> "0x199e3499880" [style=solid, color="#2E86AB", penwidth=2];
    "0x199e3499880" -> "NodeId(77)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(77)" -> "0x199e3464e60" [style=solid, color="#2E86AB", penwidth=2];
    "0x199e3464e60" -> "NodeId(78)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(75)" -> "0x199e3464e00" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(78)" -> "0x199e3464e00" [style=solid, color="#2E86AB", penwidth=2];
    "0x199e3464e00" -> "NodeId(79)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(80)" -> "0x199e3464e90" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(73)" -> "0x199e3464e90" [style=solid, color="#2E86AB", penwidth=2];
    "0x199e3464e90" -> "NodeId(81)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(81)" -> "0x199e3464f80" [style=solid, color="#2E86AB", penwidth=2];
    "0x199e3464f80" -> "NodeId(82)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(79)" -> "0x199e3465010" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(82)" -> "0x199e3465010" [style=solid, color="#2E86AB", penwidth=2];
    "0x199e3465010" -> "NodeId(83)" [style=solid, color="#2E86AB", penwidth=2];
}
