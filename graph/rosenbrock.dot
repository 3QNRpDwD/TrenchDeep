digraph ComputationGraph {
bgcolor="#F8F9FA";
rankdir=LR;  // 좌우 배치로 데이터 흐름을 더 직관적으로
splines=ortho;
nodesep=0.8;
ranksep=1.5;
node [fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=8];

    "Pointer { addr: 0x1cf2b568290, metadata: DynMetadata(0x7ff75675e378) }" [label="Mul", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1cf2b553170, metadata: DynMetadata(0x7ff75675e2f0) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(52)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(60)" [label="scalar_6", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(12)" [label="x0", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "Pointer { addr: 0x1cf2b553230, metadata: DynMetadata(0x7ff75675e420) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "Pointer { addr: 0x1cf2b55e360, metadata: DynMetadata(0x7ff75675e2f0) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(38)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(41)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1cf2b527ef0, metadata: DynMetadata(0x7ff75675e2f0) }" [label="Square", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(13)" [label="x1", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "NodeId(15)" [label="scalar", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
    "Pointer { addr: 0x1cf2b55e3c0, metadata: DynMetadata(0x7ff75675e420) }" [label="Sub", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(30)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(61)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "Pointer { addr: 0x1cf2b563010, metadata: DynMetadata(0x7ff75675e340) }" [label="Add", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
    "NodeId(82)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    "NodeId(68)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
    { rank=source; "NodeId(60)"; "NodeId(12)"; "NodeId(13)"; "NodeId(15)"; }

    // 범례
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor="#FFFFFF";
        fontsize=12;
        fontname="Arial Bold";
        
        legend_input [label="Input", shape=ellipse, style="filled,bold", fillcolor="#81C784", fontcolor="white"];
        legend_func [label="Function", shape=box, style="filled,rounded", fillcolor="#64B5F6", fontcolor="white"];
        legend_var [label="Variable", shape=ellipse, style="filled", fillcolor="#FFB74D", fontcolor="white"];
        legend_output [label="Output", shape=ellipse, style="filled,bold", fillcolor="#E57373", fontcolor="white"];
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
    }

    "NodeId(12)" -> "Pointer { addr: 0x1cf2b527ef0, metadata: DynMetadata(0x7ff75675e2f0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1cf2b527ef0, metadata: DynMetadata(0x7ff75675e2f0) }" -> "NodeId(30)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(13)" -> "Pointer { addr: 0x1cf2b553230, metadata: DynMetadata(0x7ff75675e420) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(30)" -> "Pointer { addr: 0x1cf2b553230, metadata: DynMetadata(0x7ff75675e420) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1cf2b553230, metadata: DynMetadata(0x7ff75675e420) }" -> "NodeId(38)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(38)" -> "Pointer { addr: 0x1cf2b553170, metadata: DynMetadata(0x7ff75675e2f0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1cf2b553170, metadata: DynMetadata(0x7ff75675e2f0) }" -> "NodeId(41)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(15)" -> "Pointer { addr: 0x1cf2b568290, metadata: DynMetadata(0x7ff75675e378) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(41)" -> "Pointer { addr: 0x1cf2b568290, metadata: DynMetadata(0x7ff75675e378) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1cf2b568290, metadata: DynMetadata(0x7ff75675e378) }" -> "NodeId(52)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(60)" -> "Pointer { addr: 0x1cf2b55e3c0, metadata: DynMetadata(0x7ff75675e420) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(12)" -> "Pointer { addr: 0x1cf2b55e3c0, metadata: DynMetadata(0x7ff75675e420) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1cf2b55e3c0, metadata: DynMetadata(0x7ff75675e420) }" -> "NodeId(61)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(61)" -> "Pointer { addr: 0x1cf2b55e360, metadata: DynMetadata(0x7ff75675e2f0) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1cf2b55e360, metadata: DynMetadata(0x7ff75675e2f0) }" -> "NodeId(68)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(52)" -> "Pointer { addr: 0x1cf2b563010, metadata: DynMetadata(0x7ff75675e340) }" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(68)" -> "Pointer { addr: 0x1cf2b563010, metadata: DynMetadata(0x7ff75675e340) }" [style=solid, color="#2E86AB", penwidth=2];
    "Pointer { addr: 0x1cf2b563010, metadata: DynMetadata(0x7ff75675e340) }" -> "NodeId(82)" [style=solid, color="#2E86AB", penwidth=2];
}
