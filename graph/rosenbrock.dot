digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "HandleId(722)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_7c6cd07a450c4f9e" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(730)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(728)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(715)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(705)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Mul_c966051a2982d8f0" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_14871376d4d715f9" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(736)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "HandleId(726)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Add_a583eaf08326a16" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "HandleId(717)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(734)" [label="scalar_10", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(732)" [label="scalar_9", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "HandleId(701)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Sub_80d7e2d04af8034f" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_91428904a639bd16" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Square_d853c04c1fd14db1" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    { rank=same; "HandleId(701)"; "HandleId(705)"; }
    { rank=same; "HandleId(717)"; "HandleId(730)"; }
    { rank=source; "HandleId(705)"; "HandleId(701)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "HandleId(701)" -> "Square_14871376d4d715f9" [style=solid, color="#2E86AB", penwidth=2];
    "Square_14871376d4d715f9" -> "HandleId(715)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(705)" -> "Sub_7c6cd07a450c4f9e" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(715)" -> "Sub_7c6cd07a450c4f9e" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_7c6cd07a450c4f9e" -> "HandleId(722)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(722)" -> "Square_d853c04c1fd14db1" [style=solid, color="#2E86AB", penwidth=2];
    "Square_d853c04c1fd14db1" -> "HandleId(726)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(717)" -> "Mul_c966051a2982d8f0" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(726)" -> "Mul_c966051a2982d8f0" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_c966051a2982d8f0" -> "HandleId(728)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(730)" -> "Sub_80d7e2d04af8034f" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(701)" -> "Sub_80d7e2d04af8034f" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_80d7e2d04af8034f" -> "HandleId(732)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(732)" -> "Square_91428904a639bd16" [style=solid, color="#2E86AB", penwidth=2];
    "Square_91428904a639bd16" -> "HandleId(734)" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(728)" -> "Add_a583eaf08326a16" [style=solid, color="#2E86AB", penwidth=2];
    "HandleId(734)" -> "Add_a583eaf08326a16" [style=solid, color="#2E86AB", penwidth=2];
    "Add_a583eaf08326a16" -> "HandleId(736)" [style=solid, color="#2E86AB", penwidth=2];
}
