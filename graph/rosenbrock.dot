digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Square_72b62d19d6f29548" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(69)" [label="scalar_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_5d8d4f46f57a0d71" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Mul_3b831b692e58f8db" [label="Mul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(78)" [label="scalar_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_b483dc06b6412eb8" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(76)" [label="scalar_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Square_19c19e17445ed631" [label="Square", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(81)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "NodeId(65)" [label="scalar", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(79)" [label="scalar_7", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(58)" [label="input_2", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(73)" [label="scalar_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(66)" [label="scalar_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "Sub_77bcdf3fd493e52a" [label="Sub", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(57)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "Add_3141b5ebcf75fbc0" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(80)" [label="scalar_8", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    { rank=same; "NodeId(78)"; "NodeId(65)"; }
    { rank=source; "NodeId(58)"; "NodeId(57)"; }
    { rank=sink; "NodeId(81)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(57)" -> "Square_19c19e17445ed631" [style=solid, color="#2E86AB", penwidth=2];
    "Square_19c19e17445ed631" -> "NodeId(66)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(58)" -> "Sub_b483dc06b6412eb8" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(66)" -> "Sub_b483dc06b6412eb8" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_b483dc06b6412eb8" -> "NodeId(69)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(69)" -> "Square_5d8d4f46f57a0d71" [style=solid, color="#2E86AB", penwidth=2];
    "Square_5d8d4f46f57a0d71" -> "NodeId(73)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(65)" -> "Mul_3b831b692e58f8db" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(73)" -> "Mul_3b831b692e58f8db" [style=solid, color="#2E86AB", penwidth=2];
    "Mul_3b831b692e58f8db" -> "NodeId(76)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(78)" -> "Sub_77bcdf3fd493e52a" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(57)" -> "Sub_77bcdf3fd493e52a" [style=solid, color="#2E86AB", penwidth=2];
    "Sub_77bcdf3fd493e52a" -> "NodeId(79)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(79)" -> "Square_72b62d19d6f29548" [style=solid, color="#2E86AB", penwidth=2];
    "Square_72b62d19d6f29548" -> "NodeId(80)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(76)" -> "Add_3141b5ebcf75fbc0" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(80)" -> "Add_3141b5ebcf75fbc0" [style=solid, color="#2E86AB", penwidth=2];
    "Add_3141b5ebcf75fbc0" -> "NodeId(81)" [style=solid, color="#2E86AB", penwidth=2];
}
