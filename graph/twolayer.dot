    "NodeId(16)" [label="Matmul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(17)" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(33)" [label="col_vec_16", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(22)" [label="col_vec_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
