digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.0;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "NodeId(19)" [label="col_vec_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(32)" [label="col_vec_15", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(21)" [label="col_vec_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(15)" [label="Sigmoid", shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white"];
    "NodeId(26)" [label="col_vec_9", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(7)" [label="input_4", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(29)" [label="col_vec_12", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(45)" [label="col_vec_28", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
