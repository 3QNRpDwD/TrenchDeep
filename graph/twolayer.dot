digraph ComputationGraph {
// 모던한 전체 스타일링
bgcolor="#FAFBFC";
rankdir=LR;
splines=curved;
nodesep=1.0;
ranksep=2.5;
pad=0.5;

// 기본 노드/엣지 스타일
node [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=11, margin=0.1];
edge [fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial", fontsize=9, color="#6B7280", penwidth=1.5];

    "Sigmoid_94c42fec0d8c91a9" [label="Sigmoid", shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white"];
    "NodeId(3)" [label="bias_2", shape=circle, style="filled", fillcolor="#F97316", fontcolor="white"];
    "NodeId(2)" [label="bias_1", shape=circle, style="filled", fillcolor="#F97316", fontcolor="white"];
    "Matmul_d977dc5506634799" [label="Matmul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "Matmul_e7ed7fb58a87cf20" [label="Matmul", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(22408)" [label="col_vec_2", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(1)" [label="weight_2", shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white"];
    "Add_ba8cbfaaa73fd0dc" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(22411)" [label="col_vec_5", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(22410)" [label="col_vec_4", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(22409)" [label="col_vec_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(202)" [label="input_100", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(22407)" [label="col_vec", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(0)" [label="weight_1", shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white"];
    "Add_b61f5c75ad5750b2" [label="Add", shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white"];
    "NodeId(22412)" [label="output", shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white"];
    "Sigmoid_b4ae45fa5f80c15" [label="Sigmoid", shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white"];
    { rank=same; "NodeId(202)"; }
    { rank=source; "NodeId(202)"; }

    // 범례 - 모던 스타일
    subgraph cluster_legend {
        label=<<B>Node Types</B>>;
        style="filled,rounded";
        fillcolor="#FFFFFF";
        color="#E5E7EB";
        penwidth=1;
        fontsize=14;
        fontname="SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Arial";
        fontcolor="#374151";
        margin=12;
        
        // 첫 번째 열
        legend_input [label=<<B>Input</B>>, shape=house, style="filled", fillcolor="#10B981", fontcolor="white", width=1.2, height=0.6];
        legend_func [label=<<B>Function</B>>, shape=hexagon, style="filled", fillcolor="#3B82F6", fontcolor="white", width=1.2, height=0.6];
        legend_var [label=<<B>Variable</B>>, shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white", width=1.2, height=0.6];
        legend_output [label=<<B>Output</B>>, shape=invhouse, style="filled", fillcolor="#EF4444", fontcolor="white", width=1.2, height=0.6];
        
        // 두 번째 열
        legend_weight [label=<<B>Weight</B>>, shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white", width=1.2, height=0.6];
        legend_bias [label=<<B>Bias</B>>, shape=circle, style="filled", fillcolor="#F97316", fontcolor="white", width=1.2, height=0.6];
        legend_loss [label=<<B>Loss</B>>, shape=octagon, style="filled", fillcolor="#EC4899", fontcolor="white", width=1.2, height=0.6];
        legend_activation [label=<<B>Activation</B>>, shape=doublecircle, style="filled", fillcolor="#06B6D4", fontcolor="white", width=1.2, height=0.6];
        
        // 범례 레이아웃
        { rank=same; legend_input; legend_weight; }
        { rank=same; legend_func; legend_bias; }
        { rank=same; legend_var; legend_loss; }
        { rank=same; legend_output; legend_activation; }
        
        legend_input -> legend_func -> legend_var -> legend_output [style=invis];
        legend_weight -> legend_bias -> legend_loss -> legend_activation [style=invis];
    }

    "NodeId(0)" -> "Matmul_e7ed7fb58a87cf20" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(202)" -> "Matmul_e7ed7fb58a87cf20" [style=solid, color="#2E86AB", penwidth=2];
    "Matmul_e7ed7fb58a87cf20" -> "NodeId(22407)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(22407)" -> "Add_b61f5c75ad5750b2" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(2)" -> "Add_b61f5c75ad5750b2" [style=solid, color="#2E86AB", penwidth=2];
    "Add_b61f5c75ad5750b2" -> "NodeId(22408)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(22408)" -> "Sigmoid_94c42fec0d8c91a9" [style=solid, color="#2E86AB", penwidth=2];
    "Sigmoid_94c42fec0d8c91a9" -> "NodeId(22409)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(1)" -> "Matmul_d977dc5506634799" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(22409)" -> "Matmul_d977dc5506634799" [style=solid, color="#2E86AB", penwidth=2];
    "Matmul_d977dc5506634799" -> "NodeId(22410)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(22410)" -> "Add_ba8cbfaaa73fd0dc" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(3)" -> "Add_ba8cbfaaa73fd0dc" [style=solid, color="#2E86AB", penwidth=2];
    "Add_ba8cbfaaa73fd0dc" -> "NodeId(22411)" [style=solid, color="#2E86AB", penwidth=2];
    "NodeId(22411)" -> "Sigmoid_b4ae45fa5f80c15" [style=solid, color="#2E86AB", penwidth=2];
    "Sigmoid_b4ae45fa5f80c15" -> "NodeId(22412)" [style=solid, color="#2E86AB", penwidth=2];
}
