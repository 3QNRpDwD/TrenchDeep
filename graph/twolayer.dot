    "NodeId(42)" [label="col_vec_25", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(0)" [label="weight_1", shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white"];
    "NodeId(20)" [label="col_vec_3", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(1)" [label="weight_2", shape=diamond, style="filled", fillcolor="#8B5CF6", fontcolor="white"];
    "NodeId(27)" [label="col_vec_10", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(36)" [label="col_vec_19", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
