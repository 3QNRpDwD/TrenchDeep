    "NodeId(18)" [label="col_vec", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(40)" [label="col_vec_23", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(4)" [label="input", shape=house, style="filled", fillcolor="#10B981", fontcolor="white"];
    "NodeId(23)" [label="col_vec_6", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
    "NodeId(2)" [label="bias_1", shape=circle, style="filled", fillcolor="#F97316", fontcolor="white"];
    "NodeId(35)" [label="col_vec_18", shape=ellipse, style="filled", fillcolor="#F59E0B", fontcolor="white"];
